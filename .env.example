NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Placar ao vivo (opcional). O cron /api/cron/sync sobrepõe o placar dos jogos
# por cima do calendário do openfootball. Precedência: worldcup26 e, na falta
# dele, SportMonks. Sem nenhum, só roda o openfootball (calendário/resultados).
#
# worldcup26.ir — API gratuita e nativa da Copa 2026 (JWT grátis via registro):
WC2026_API_KEY=your-worldcup26-jwt-token
WC2026_API_BASE_URL=https://worldcup26.ir
# SportMonks (fallback; exige plano com a Copa 2026):
# SPORTMONKS_API_TOKEN=your-sportmonks-api-token
# SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football
CRON_SECRET=generate-a-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
