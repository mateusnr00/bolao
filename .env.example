NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Placar ao vivo — fonte oficial única: worldcup26.ir (API gratuita e nativa da
# Copa 2026; JWT grátis via registro). O cron /api/cron/sync usa essa fonte pra
# marcar live/encerrado e atualizar o placar.
WC2026_API_KEY=your-worldcup26-jwt-token
WC2026_API_BASE_URL=https://worldcup26.ir
CRON_SECRET=generate-a-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
